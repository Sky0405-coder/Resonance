# Copy to .env next to docker-compose.yml and fill in.

# Required
POSTGRES_PASSWORD=change-me-to-a-long-random-string
MUSIC_PATH=/path/to/your/music

# Owner of the music files (id -u / id -g); Resonance and qBittorrent run as this user.
PUID=1000
PGID=1000
TZ=Europe/Berlin

# Optional paths (defaults: folders under ./data). DOWNLOADS_PATH should be on the same disk as MUSIC_PATH,
# then finished torrents are hardlinked instead of copied and keep seeding.
#DOWNLOADS_PATH=/path/to/downloads
#BOOKS_PATH=/path/to/ebooks
#IMPORT_PATH=/path/to/import-drop-folder
#APPDATA_PATH=/path/on/ssd/resonance
#APP_PORT=8765
# Pin a version instead of the newest release, e.g. 1.6.17
#RESONANCE_VERSION=latest

# Profile "torrents": WireGuard config of your VPN (with port forwarding, e.g. ProtonVPN "NAT-PMP")
#VPN_SERVICE_PROVIDER=protonvpn
#WIREGUARD_PRIVATE_KEY=
#WIREGUARD_ADDRESSES=10.2.0.2/32
#VPN_SERVER_COUNTRIES=Netherlands

# Profile "audiobooks"
#AUDIOBOOKS_PATH=/path/to/audiobooks
